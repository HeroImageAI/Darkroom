{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "darkroom_placeholder.png"
    },
    "_meta": {
      "title": "DR_IMAGE_1"
    }
  },
  "2": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sam3.1_multiplex_fp16.safetensors"
    },
    "_meta": {
      "title": "SAM 3.1"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": [
        "2",
        1
      ]
    },
    "_meta": {
      "title": "DR_TEXT"
    }
  },
  "4": {
    "class_type": "SAM3_Detect",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "image": [
        "1",
        0
      ],
      "conditioning": [
        "3",
        0
      ],
      "threshold": 0.5,
      "refine_iterations": 2,
      "individual_masks": true
    },
    "_meta": {
      "title": "DR_SAM"
    }
  },
  "5": {
    "class_type": "InvertMask",
    "inputs": {
      "mask": [
        "4",
        0
      ]
    },
    "_meta": {
      "title": "Invert"
    }
  },
  "6": {
    "class_type": "JoinImageWithAlpha",
    "inputs": {
      "image": [
        "1",
        0
      ],
      "alpha": [
        "5",
        0
      ]
    },
    "_meta": {
      "title": "Object layers"
    }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "6",
        0
      ],
      "filename_prefix": "darkroom/layers/object"
    },
    "_meta": {
      "title": "DR_OUTPUT"
    }
  },
  "8": {
    "class_type": "SAM3_Detect",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "image": [
        "1",
        0
      ],
      "conditioning": [
        "3",
        0
      ],
      "threshold": 0.5,
      "refine_iterations": 2,
      "individual_masks": false
    },
    "_meta": {
      "title": "SAM union"
    }
  },
  "9": {
    "class_type": "GrowMask",
    "inputs": {
      "mask": [
        "8",
        0
      ],
      "expand": 16,
      "tapered_corners": true
    },
    "_meta": {
      "title": "Union grow"
    }
  },
  "10": {
    "class_type": "MaskToImage",
    "inputs": {
      "mask": [
        "9",
        0
      ]
    },
    "_meta": {
      "title": "Union image"
    }
  },
  "11": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "10",
        0
      ],
      "filename_prefix": "darkroom/masks/union"
    },
    "_meta": {
      "title": "DR_MASK_OUT"
    }
  }
}