{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "darkroom_placeholder.mp4"
    },
    "_meta": {
      "title": "DR_VIDEO"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "Components"
    }
  },
  "3": {
    "class_type": "FrameInterpolationModelLoader",
    "inputs": {
      "model_name": "rife_v4.26.safetensors"
    },
    "_meta": {
      "title": "DR_MODEL"
    }
  },
  "4": {
    "class_type": "FrameInterpolate",
    "inputs": {
      "interp_model": [
        "3",
        0
      ],
      "images": [
        "2",
        0
      ],
      "multiplier": 2
    },
    "_meta": {
      "title": "DR_MULTIPLIER"
    }
  },
  "5": {
    "class_type": "PrimitiveFloat",
    "inputs": {
      "value": 32.0
    },
    "_meta": {
      "title": "DR_FPS"
    }
  },
  "6": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "4",
        0
      ],
      "fps": [
        "5",
        0
      ],
      "audio": [
        "2",
        1
      ]
    },
    "_meta": {
      "title": "Create video"
    }
  },
  "7": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "6",
        0
      ],
      "filename_prefix": "darkroom/video/smooth",
      "format": "mp4",
      "format.codec": "h264"
    },
    "_meta": {
      "title": "DR_OUTPUT"
    }
  },
  "8": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "4",
        0
      ],
      "batch_index": 0,
      "length": 1
    },
    "_meta": {
      "title": "Poster frame"
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "8",
        0
      ],
      "filename_prefix": "darkroom/video/smooth_poster"
    },
    "_meta": {
      "title": "DR_POSTER"
    }
  }
}