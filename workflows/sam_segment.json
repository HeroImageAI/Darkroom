{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "darkroom_placeholder.png"
    },
    "_meta": {
      "title": "DR_IMAGE_1"
    }
  },
  "2": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sam3.1_multiplex_fp16.safetensors"
    },
    "_meta": {
      "title": "SAM 3.1"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": [
        "2",
        1
      ]
    },
    "_meta": {
      "title": "DR_TEXT"
    }
  },
  "4": {
    "class_type": "SAM3_Detect",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "image": [
        "1",
        0
      ],
      "conditioning": [
        "3",
        0
      ],
      "threshold": 0.5,
      "refine_iterations": 2,
      "individual_masks": false
    },
    "_meta": {
      "title": "DR_SAM"
    }
  },
  "5": {
    "class_type": "MaskToImage",
    "inputs": {
      "mask": [
        "4",
        0
      ]
    },
    "_meta": {
      "title": "Mask to image"
    }
  },
  "6": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "5",
        0
      ],
      "filename_prefix": "darkroom/masks/sam"
    },
    "_meta": {
      "title": "DR_OUTPUT"
    }
  }
}