{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "darkroom_placeholder.mp4"
    },
    "_meta": {
      "title": "DR_VIDEO"
    }
  },
  "2": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "darkroom_placeholder.mp4"
    },
    "_meta": {
      "title": "DR_VIDEO_2"
    }
  },
  "3": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "Take"
    }
  },
  "4": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Matte"
    }
  },
  "5": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": [
        "3",
        0
      ]
    },
    "_meta": {
      "title": "Take size"
    }
  },
  "6": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "4",
        0
      ],
      "upscale_method": "bilinear",
      "width": [
        "5",
        0
      ],
      "height": [
        "5",
        1
      ],
      "crop": "disabled"
    },
    "_meta": {
      "title": "Matte to take size"
    }
  },
  "7": {
    "class_type": "ImageToMask",
    "inputs": {
      "image": [
        "6",
        0
      ],
      "channel": "red"
    },
    "_meta": {
      "title": "Matte as mask"
    }
  },
  "8": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "darkroom_placeholder.png"
    },
    "_meta": {
      "title": "DR_IMAGE_1"
    }
  },
  "9": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "8",
        0
      ],
      "upscale_method": "lanczos",
      "width": [
        "5",
        0
      ],
      "height": [
        "5",
        1
      ],
      "crop": "center"
    },
    "_meta": {
      "title": "Background to frame"
    }
  },
  "10": {
    "class_type": "RepeatImageBatch",
    "inputs": {
      "image": [
        "9",
        0
      ],
      "amount": [
        "5",
        2
      ]
    },
    "_meta": {
      "title": "Background per frame"
    }
  },
  "11": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": [
        "10",
        0
      ],
      "source": [
        "3",
        0
      ],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": [
        "7",
        0
      ]
    },
    "_meta": {
      "title": "Composite"
    }
  },
  "12": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "11",
        0
      ],
      "fps": [
        "3",
        2
      ],
      "audio": [
        "3",
        1
      ]
    },
    "_meta": {
      "title": "Create video"
    }
  },
  "13": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "12",
        0
      ],
      "filename_prefix": "darkroom/video/cutout",
      "format": "mp4",
      "format.codec": "h264"
    },
    "_meta": {
      "title": "DR_OUTPUT"
    }
  },
  "14": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "11",
        0
      ],
      "batch_index": 0,
      "length": 1
    },
    "_meta": {
      "title": "Poster frame"
    }
  },
  "15": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "14",
        0
      ],
      "filename_prefix": "darkroom/video/cutout_poster"
    },
    "_meta": {
      "title": "DR_POSTER"
    }
  },
  "16": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "11",
        0
      ],
      "batch_index": 4095,
      "length": 1
    },
    "_meta": {
      "title": "Last frame"
    }
  },
  "17": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "16",
        0
      ],
      "filename_prefix": "darkroom/video/cutout_last"
    },
    "_meta": {
      "title": "DR_LAST_FRAME"
    }
  }
