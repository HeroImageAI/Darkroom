node_modules/
dist/
data/
logs/
bench/
proof/e2e-artifacts/
proof/e2e-report/
research/templates/*.json
.env
*.part

# raw QA renders stay on disk; grids + runs.json are committed
docs/qa/*/*/

# addenda phases keep grids + runs.json one level deeper; raw renders below that stay untracked
!docs/qa/addenda/*/
docs/qa/addenda/*/*/

# outpaint canvases are rebuilt by scripts/ab-addenda.ts setup
tests/golden/outpaint/

# test-suite run: browser profile and the user-supplied inputs
tests/results/.edge-profile/
test-inputs/
tests/results/.dev.log
tests/results/.spec.json
tests/results/.plan*.out
tests/results/.plan*.err
